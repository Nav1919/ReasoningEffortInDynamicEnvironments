# ignore our local Python environment
.venv/

# ignore API keys but allow a placeholder template
.env
.env.*
!.env.example

# ignore Python cache files
__pycache__/
*.py[cod]

# ignore generated episode logs
logs/

# ignore macOS folder metadata
.DS_Store
# ignore local agent runtime and isolated checkouts
.runtime/
.worktrees/

# Keep full generated banks local; commit summaries and small examples.
/data/situation_bank/*/states.json
/data/situation_bank/*/labels.json
/data/situation_bank/*/candidate_inventory.json
/data/situation_bank/freeway_pilot_v1/
