{
  "model": {"openai_runtime": "auto"},
  "agent": {"max_turns": 20, "run_budget_seconds": 300},
  "toolsets": ["kanban", "cronjob"],
  "platform_toolsets": {"discord": ["kanban", "cronjob"], "cron": ["kanban"]},
  "kanban": {
    "dispatch_in_gateway": false, "dispatch_profiles": [],
    "auto_decompose": false, "auto_promote_children": false,
    "review_dispatch": false, "max_in_progress": 1,
    "failure_limit": 1, "notify_in_gateway": true
  }
}
